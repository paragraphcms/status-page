STATUS_ENDPOINTS_JSON='[
  {
    "name": "Landing",
    "description": "Main public website hosting the product documentation, feature overview, and information for prospective users.",
    "type": "http",
    "url": "https://paragraphcms.com",
    "method": "GET",
    "expectedStatus": [200],
    "timeoutMs": 5000
  },
  {
    "name": "App",
    "description": "Core CMS application used by authenticated users to manage content, configure projects, and access administrative features.",
    "type": "http",
    "url": "https://app.paragraphcms.com/sign-in",
    "method": "GET",
    "expectedStatus": [200],
    "timeoutMs": 5000
  },
  {
    "name": "CDN",
    "description": "Content Delivery Network responsible for serving user-uploaded assets and media files with high availability and optimized performance.",
    "type": "http",
    "url": "https://cdn.paragraphcms.com/users/e3e34912-97ce-4020-87f6-f035413a5c40/avatar.webp?key=users%2Fe3e34912-97ce-4020-87f6-f035413a5c40.webp",
    "method": "GET",
    "expectedStatus": [200],
    "timeoutMs": 5000
  },
  {
    "name": "API",
    "description": "Primary API gateway exposing the Paragraph CMS backend services used for integrations and client applications.",
    "type": "http",
    "url": "https://api.paragraphcms.com/v1/openapi.json",
    "method": "GET",
    "expectedStatus": [200],
    "timeoutMs": 5000,
    "expectedBodyIncludes": "openapi"
  }
]'
