PAGE_TITLE="Status Page"
LOGO_URL="https://example.com/logo.png"
RETENTION_DAYS="30"
MOCK_PREVIOUS_DAYS=""
CLEANUP_CRON="0 3 * * *"

# Used by the local Bun/SQLite runtime and Docker.
PORT="3000"
DATABASE_PATH="./status.sqlite"

# Cloudflare D1 is configured in wrangler.jsonc as a binding named DB.
# Paste the D1 database_id into wrangler.jsonc, not here.

STATUS_ENDPOINTS_JSON='[
  {
    "name": "API health",
    "description": "Core backend platform health endpoint.",
    "type": "http",
    "url": "https://api.example.com/health",
    "method": "GET",
    "expectedStatus": [200],
    "timeoutMs": 5000,
    "expectedBodyIncludes": "ok",
    "expectedJson": {
      "status": "ok"
    }
  },
  {
    "name": "SSL cert",
    "description": "Public TLS certificate check.",
    "type": "ssl",
    "host": "example.com",
    "port": 443,
    "warnBeforeDays": 14,
    "timeoutMs": 5000
  },
  {
    "name": "Postgres",
    "description": "Database TCP port availability.",
    "private": true,
    "type": "tcp",
    "host": "db.example.com",
    "port": 5432,
    "timeoutMs": 3000
  },
  {
    "name": "DNS example.com",
    "description": "DNS A record resolution.",
    "type": "dns",
    "host": "example.com",
    "recordType": "A",
    "timeoutMs": 5000
  }
]'
